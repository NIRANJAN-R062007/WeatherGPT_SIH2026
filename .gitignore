.env
CLAUDE.md
.venv/
__pycache__/
*.pyc
# pytest/ruff write their own nested .gitignore into these, which only holds
# until someone cleans the directory — list them here too.
.pytest_cache/
.ruff_cache/
.DS_Store
data/fixtures/*.local.json
data/fixtures/**/*.local.json
.idea/

# Kubernetes real secret (see k8s/base/secret.example.yaml)
k8s/base/secret.yaml

# k6 load test server logs and timestamped result files
loadtest/results/*.log
loadtest/results/spike-*.json
loadtest/results/abuse-*.json
loadtest/results/llm-*.json

# advisory eval results (ml/advisory/run_eval.py --out; kept for --resume, the
# numbers go into plan.md TFA-18)
ml/advisory/*.json

# IVR simulated-call output (services/orchestrator/ivr_simulate.py)
ivr-sim-output/

# GeoNames downloads for scripts/import_geonames.py (CC-BY 4.0, large; the
# generated data/gazetteer/in_places.json.gz is what gets committed)
data/geonames/
