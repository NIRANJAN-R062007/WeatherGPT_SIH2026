# Base URL of the WeatherGPT orchestrator that serves GET /ask (services/orchestrator).
# :8001 is the orchestrator directly, the same default prototype/frontend/WeatherGPT.dc.html
# uses; point this at :8000 to go through the gateway reverse proxy instead.
VITE_API_BASE_URL=http://localhost:8001

# Optional dev proxy for a deployed orchestrator that doesn't allow this
# origin (CORS): forwards /api/* to it, so pair it with VITE_API_BASE_URL=/api.
# API_PROXY_TARGET=https://your-orchestrator.example
