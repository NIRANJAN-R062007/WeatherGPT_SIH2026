# Copy to .env and fill in as needed.
# DATABASE_URL and REDIS_URL are already wired in docker-compose.yml's
# environment block for the gateway service — no need to duplicate here
# unless overriding for local (non-docker) runs.

# Bhashini
# Classic ULCA: USER_ID + ULCA_API_KEY. Udyat: ULCA_API_KEY (the "udyat key") + INFERENCE_KEY.
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_INFERENCE_KEY=

# Weather data
GOOGLE_WEATHER_API_KEY=

# LLM providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Second-provider fallback (plan.md §5) — used when Gemini fails/503s, before
# the template fallback. Groq deprecated llama-3.3-70b-versatile (their
# recommended replacement, gpt-oss-120b, is used here); model id must be a
# currently-live Groq model — check https://console.groq.com/docs/deprecations
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# CORS for the /ask prototype — comma-separated origins; unset means "*"
ALLOWED_ORIGINS=

# Weather source: auto (default) | live | fixtures (offline kill switch)
WEATHER_MODE=auto
