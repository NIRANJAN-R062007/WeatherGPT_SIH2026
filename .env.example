# Copy to .env and fill in as needed.
# DATABASE_URL and REDIS_URL are already wired in docker-compose.yml's
# environment block for both the gateway and orchestrator services — no need
# to duplicate here unless overriding for local (non-docker) runs.

# Bhashini
# Classic ULCA: USER_ID + ULCA_API_KEY. Udyat: ULCA_API_KEY (the "udyat key") + INFERENCE_KEY.
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_INFERENCE_KEY=

# Weather data
GOOGLE_WEATHER_API_KEY=

# Google Stitch MCP (design-to-code) — stitch.withgoogle.com > profile >
# Stitch settings > API key > Create key. Used by .mcp.json's "stitch" server
# so Claude Code/Cursor/etc can pull screens from a Stitch project directly.
STITCH_API_KEY=

# How many days of weather_facts history to keep (services/orchestrator/
# weather_store.py's retention sweep, run hourly on the background writer
# thread). Unset defaults to 30; 0 keeps everything, which on Render's free
# 1 GB Postgres eventually fills the disk.
WEATHER_FACTS_RETENTION_DAYS=30

# Per-product cache TTL, in seconds (services/orchestrator/google_weather.py's
# L1/L2 cache; plan.md §8 Phase 1 cache-strategy tuning). current_conditions
# is short because "weather right now" answers quote it directly; the hourly
# series only updates a few times an hour; daily forecast is the most stable
# and the cheapest to leave cached longest.
TTL_CURRENT_CONDITIONS_SECONDS=900
TTL_FORECAST_HOURS_SECONDS=3600
TTL_FORECAST_DAYS_SECONDS=21600
TTL_HISTORY_HOURS_SECONDS=3600

# LLM providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Second-provider fallback (plan.md §5) — used when Gemini fails/503s, before
# the template fallback. Groq deprecated llama-3.3-70b-versatile (their
# recommended replacement, gpt-oss-120b, is used here); model id must be a
# currently-live Groq model — check https://console.groq.com/docs/deprecations
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Third provider: local Ollama, tried after Gemini/Groq (or first when
# OFFLINE_MODE=1). OLLAMA_BASE=http://ollama:11434 when using the compose
# "offline" profile; localhost for a host-installed Ollama.
OLLAMA_BASE=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=30

# Public-surface limits: max request body (bytes) and per-client requests per
# minute on /ask, /asr, /tts. RATE_LIMIT_PER_MINUTE=0 disables the limiter.
MAX_BODY_BYTES=2097152
RATE_LIMIT_PER_MINUTE=30
# Proxies between the internet and the orchestrator, the gateway counting as
# one — the limiter keys on the X-Forwarded-For hop the outermost of them
# appended, never on the leftmost (client-supplied) one. Plain docker compose
# or the orchestrator alone on Render: 1. Behind ngrok (run_tunnel.sh) or the
# k8s ingress, with the gateway in between: 2. No proxy at all: 0. Both
# services read this; see services/orchestrator/limits.py for the table.
TRUSTED_PROXY_HOPS=1

# CORS for the orchestrator's public routes — comma-separated origins; unset means "*"
ALLOWED_ORIGINS=

# Weather source: auto (default) | live | fixtures (offline kill switch)
WEATHER_MODE=auto

# Demo-morning kill switch (plan.md §8 Phase 6): fixtures only, Gemini/Groq
# skipped (Ollama -> template), Bhashini disabled. Never commit this as 1.
OFFLINE_MODE=0

# RAG grounding (plan.md §14 Task C): feeds a couple of IMD reference
# passages (colour codes, rainfall categories, UV bands, ...) into the
# narration prompt for category wording only. Defaults ON when unset.
RAG_ENABLED=1

# IMD warning colour-code banner (plan.md §14 Task D). services/orchestrator/
# imd_warnings.py only reads hand-written fixtures under data/fixtures/
# imd_warnings/, not a live CAP/SACHET feed — so this defaults OFF and
# /warnings answers status "unavailable" (never a fake "orange alert", never
# an all-clear). Set to 1 only for a deliberate demo of the banner.
WARNINGS_ENABLED=0

# Supabase (plan.md §14 Deepthi track — Google OAuth + DB).
# Project Settings > API in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Static demo page the orchestrator serves at / (services/orchestrator/main.py).
# Unset = API-only: no static mount, / just points at /health and /docs.
# docker-compose.yml, render.yaml and k8s/base/configmap.yaml set it to the
# path baked into the image, /app/prototype/frontend; a bare `uvicorn main:app`
# from services/orchestrator/ wants ../../prototype/frontend.
FRONTEND_DIR=
